# Server
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*

# MongoDB (local mongod or Atlas). Change streams need a replica set.
MONGODB_URI=mongodb://localhost:27017/instant

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Payments (ARCHITECTURE §8). PAYMENTS_PROVIDER=mock is allowed outside production.
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Seed (pnpm seed)
ADMIN_EMAIL=admin@instant.local
ADMIN_PASSWORD=Admin12345!

# Optional: name of the Atlas Search index on `products`. Empty = regex fallback.
ATLAS_SEARCH_INDEX=
